# Copy to apps/mobile/.env for local development. Only public values: they are
# embedded in the app bundle.

# API root including the version prefix.
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
# Auth gateway in front of Ory Kratos (ADR-0008).
EXPO_PUBLIC_KRATOS_URL=http://localhost:8080/auth
# Crisis numbers to show before the first successful contact with the server.
EXPO_PUBLIC_CRISIS_PHONES=[{"number":"+70000000000","label":"Example crisis line"}]
# Store identifier for native builds (reverse domain of the operator).
BIRGE_APP_ID=invalid.example.birge
