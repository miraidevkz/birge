# Copy to apps/admin/.env for local development. Only public values: they are
# embedded in the app bundle.

# API root including the version prefix.
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
# Staff OIDC issuer (discovery at <issuer>/.well-known/openid-configuration).
EXPO_PUBLIC_STAFF_ISSUER=http://localhost:4444/
# Public OIDC client id for the authorization-code + PKCE flow.
EXPO_PUBLIC_STAFF_CLIENT_ID=birge-admin
