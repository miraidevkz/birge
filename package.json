{
  "name": "birge-clients",
  "private": true,
  "description": "npm workspaces for the Birge clients (ADR-0004). The Go backend does not use npm.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/mobile",
    "packages/ui",
    "packages/api",
    "packages/i18n"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "api-gen": "npm run api-gen -w @birge/api",
    "api-check": "npm run api-check -w @birge/api",
    "web-build": "npm run web-build -w @birge/mobile",
    "check": "npm run typecheck && npm run lint && npm run test && npm run api-check && npm run web-build"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
