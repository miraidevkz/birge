// Module ci pins the CI-only tools (govulncheck, oasdiff, actionlint) apart from birge/tools,
// so their dependencies never move the versions golangci-lint and oapi-codegen
// are built with (oasdiff alone would upgrade kin-openapi and x/tools there).
module birge/tools/ci

go 1.27

tool (
	github.com/oasdiff/oasdiff
	github.com/rhysd/actionlint/cmd/actionlint
	golang.org/x/vuln/cmd/govulncheck
)

require (
	cloud.google.com/go v0.123.0 // indirect
	github.com/TwiN/go-color v1.4.1 // indirect
	github.com/bahlo/generic-list-go v0.2.0 // indirect
	github.com/bmatcuk/doublestar/v4 v4.10.0 // indirect
