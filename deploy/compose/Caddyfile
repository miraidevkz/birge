# Development web client on one origin with the API, so the browser needs no
# CORS: /v1 and /auth go to the birge api, everything else is the exported
# Expo web app (apps/mobile/dist, a single-page app).
:8081 {
	# Demo sign-in codes of the synthetic demo numbers only (cmd/birge-devsms
	# answers 404 for every other number and when no demo prefix is set).
	handle /demo/code {
		reverse_proxy devsms:4000
	}
	handle /v1/* {
		reverse_proxy api:8080
	}
	handle /auth/* {
		reverse_proxy api:8080
	}
	# The external emergency plan page: never cached, and no Referer leaves it
	# (the token itself is in the fragment and cleared by the page).
	header /plan {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The staff admin (apps/admin/dist) on its own origin; it signs in at the
# development Hydra (http://localhost:4444/) and calls the API here.
:8082 {
	handle /v1/* {
		reverse_proxy api:8080
	}
	handle {
		root * /srv-admin
		try_files {path} /index.html
		file_server
	}
}
